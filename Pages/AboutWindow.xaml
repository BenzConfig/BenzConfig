<Window x:Class="benzconfig.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Height="300"
        Width="500"
        Title="О программе"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#0C0C0C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#000000">

                <Button Click="BtnClose_Click"
                        Style="{StaticResource WindowClose}"/>

            </Border>

            <Grid Grid.Row="1"
                  Margin="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <svgc:SvgViewbox Grid.Column="0" 
                                 Width="150" 
                                 Stretch="Uniform" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Left" 
                                 Margin="25,0,0,15" 
                                 Source="/Assets/Images/Logos/Logotype.svg"/>

                <StackPanel Grid.Column="1"
                            Margin="0,0,0,15"
                            VerticalAlignment="Center">

                    <TextBlock Text="BenzConfig 2.5"
                               Foreground="#BABABA"
                               FontFamily="/Assets/Fonts/#Bai Jamjuree"
                               FontSize="24"
                               Margin="0,0,0,10"/>

                    <TextBlock FontSize="14"
                               FontFamily="Manrope"
                               FontWeight="Regular">
                            
                        <Run Text="Лицензия "
                             Foreground="#B4B4B4"/>
                            
                        <Hyperlink
                            NavigateUri="https://github.com/BenzConfig/BenzConfig/blob/main/LICENSE"
                            RequestNavigate="Hyperlink_RequestNavigate"
                            TextDecorations="{x:Null}">
                            
                                MIT License
                            
                            <Hyperlink.Style>
                                <Style
                                    TargetType="Hyperlink">
                                    <Setter
                                        Property="Foreground"
                                        Value="#787878"/>
                                    
                                    <Style.Triggers>
                                        <Trigger
                                            Property="IsMouseOver"
                                            Value="True">
                                            
                                            <Setter
                                                Property="Foreground"
                                                Value="#FD2357"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            
                        </Hyperlink>

                    </TextBlock>

                    <TextBlock FontSize="14"
                               FontFamily="Manrope"
                               FontWeight="Regular">
                            
                            <Run Text="Веб-сайт "
                                Foreground="#B4B4B4"/>
    
                            <Hyperlink
                                NavigateUri="https://www.nrgs.tilda.ws"
                                RequestNavigate="Hyperlink_RequestNavigate"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                TextDecorations="{x:Null}">
                                
                                    www.nrgs.tilda.ws
                                
                                <Hyperlink.Style>
                                    <Style
                                        TargetType="Hyperlink">
                                        <Setter
                                            Property="Foreground"
                                            Value="#787878"/>
                                        
                                        <Style.Triggers>
                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">
                                                
                                                <Setter
                                                    Property="Foreground"
                                                    Value="#FD2357"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                            </Hyperlink>

                    </TextBlock>

                    <TextBlock FontSize="14"
                               FontFamily="Manrope"
                               FontWeight="Regular">
                        <Run
                            Text="Исходник "
                            Foreground="#B4B4B4"/>
    
                        <Hyperlink
                            NavigateUri="https://github.com/BenzConfig/BenzConfig"
                            RequestNavigate="Hyperlink_RequestNavigate"
                            FontFamily="Manrope"
                            FontWeight="Regular"
                            TextDecorations="{x:Null}">
                            
                            www.github.com
                            
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    
                                    <Setter
                                        Property="Foreground"
                                        Value="#787878"/>
                                    
                                    <Style.Triggers>
                                        <Trigger
                                            Property="IsMouseOver"
                                            Value="True">
                                            
                                            <Setter
                                                Property="Foreground"
                                                Value="#FD2357"/>
                                        </Trigger>
                                    </Style.Triggers>
                                    
                                </Style>
                            </Hyperlink.Style>
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="© 2024 NRG'S. All right reserved."
                                Opacity="0.6"
                                Foreground="Gray"
                                FontSize="14"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                Margin="0,10,0,0"/>

                </StackPanel>

            </Grid>

            <TextBlock Grid.Row="2"
                       Text="build 211126 ver 2.5.3"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.4"
                       Foreground="Gray"
                       FontSize="13"
                       FontFamily="Manrope"
                       FontWeight="Light"/>
            
        </Grid>
    </Border>
    
</Window>