<Window x:Class="benzconfig.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="Settings"
        Height="390"
        Width="630"
        Background="#0A0A0A"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border  Grid.Row="0"
                     Background="#000000">

                <Button Click="BtnClose_Click"
                        Style="{StaticResource WindowClose}"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1"
                  Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Летний -->
                <StackPanel Grid.Column="0"
                            Margin="10">

                    <TextBlock Text="Летний режим"
                                Foreground="#888888"
                                FontFamily="Manrope"
                                FontSize="14"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"/>

                    <TextBlock Text="Пропорции"
                                Foreground="#AFAFAF"
                                FontFamily="Manrope"
                                FontSize="13"
                                Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        
                        <TextBlock Text="Город"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,27,0"/>

                        <TextBox x:Name="PropCitySummer"
                                Style="{StaticResource Inputs}"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="12"
                                Width="200"
                                Height="30"
                                MaxLength="5"
                                PreviewTextInput="NumberOnly"/>
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,5">

                        <TextBlock Text="Трасса"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"
                                    PreviewTextInput="NumberOnly"/>
                    
                        <TextBox x:Name="PropHighwaySummer"
                                Style="{StaticResource Inputs}"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="12"
                                Width="200"
                                Height="30"
                                MaxLength="5"
                                PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                    <TextBlock Text="Нормы расхода"
                                Foreground="#AFAFAF"
                                FontFamily="Manrope"
                                FontSize="13"
                                Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="Город"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,27,0"
                                    PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="RatesCitySummer"
                                Style="{StaticResource Inputs}"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="12"
                                Width="200"
                                Height="30"
                                PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="Трасса"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"
                                    PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="RatesHighwaySummer"
                                Style="{StaticResource Inputs}"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="12"
                                Width="200"
                                Height="30"
                                PreviewTextInput="NumberOnly"/>

                    </StackPanel>
                    
                </StackPanel>

                <!-- Зимний -->
                <StackPanel Grid.Column="1" Margin="10">

                    <TextBlock Text="Зимний режим"
                                Foreground="#888888"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="14"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"/>

                    <TextBlock Text="Пропорции"
                                Foreground="#AFAFAF"
                                FontFamily="Manrope"
                                FontSize="13"
                                Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock Text="Город"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,27,0"
                                    PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="PropCityWinter"
                                Style="{StaticResource Inputs}"
                                FontFamily="Manrope"
                                FontWeight="Regular"
                                FontSize="12"
                                Width="200"
                                Height="30"
                                MaxLength="5"
                                PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="Трасса"
                                    Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"
                                    PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="PropHighwayWinter"
                                    Style="{StaticResource Inputs}"
                                    FontFamily="Manrope"
                                    FontWeight="Regular"
                                    FontSize="12"
                                    Width="200"
                                    Height="30"
                                    MaxLength="5"
                                    PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                    <TextBlock Text="Нормы расхода"
                               Foreground="#AFAFAF"
                               FontFamily="Manrope"
                               FontSize="13"
                               Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock Text="Город"
                                   Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,27,0"
                                   PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="RatesCityWinter"
                                 Style="{StaticResource Inputs}"
                                 FontFamily="Manrope"
                                 FontWeight="Regular"
                                 FontSize="12"
                                 Width="200"
                                 Height="30"
                                 PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <TextBlock Text="Трасса"
                                   Foreground="#666666"
                                    FontFamily="Manrope"
                                    FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   PreviewTextInput="NumberOnly"/>

                        <TextBox x:Name="RatesHighwayWinter"
                                 Style="{StaticResource Inputs}"
                                 FontFamily="Manrope"
                                 FontWeight="Regular"
                                 FontSize="12"
                                 Width="200"
                                 Height="30"
                                 PreviewTextInput="NumberOnly"/>

                    </StackPanel>

                </StackPanel>
                
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2">

                <Button Click="BtnSave_Click"
                        Width="100"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource Calculate}"
                        IsDefault="True">

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <svgc:SvgViewbox 
                            Width="11"
                            Height="Auto"
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Source="/Assets/Images/Buttons/check.svg"/>

                    </StackPanel>

                </Button>

            </Border>

        </Grid>
        
    </Border>
    
</Window>