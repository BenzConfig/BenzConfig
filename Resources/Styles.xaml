<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">

    <Style x:Key="Inputs" TargetType="TextBox">

        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="#191919"/>
        <Setter Property="Foreground" Value="#EAEAEA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3E403F"/>
        <Setter Property="MaxLength" Value="10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="#777777"/>
        <Setter Property="SelectionBrush" Value="#555555"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Grid>

                        <Border x:Name="Border"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>

                        <!-- Текст -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="5,0,5,0"
                                      VerticalAlignment="Center"/>

                        <!-- Watermark -->
                        <TextBlock x:Name="Watermark"
                                   Text="Введите данные"
                                   Margin="8,0,0,0"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>

                            </MultiTrigger.Conditions>

                            <Setter TargetName="Watermark"
                                    Property="Visibility"
                                    Value="Visible"/>

                        </MultiTrigger>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">

                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#555555"/>

                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#555555"/>

                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">

                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="#2A2A2A"/>

                            <Setter Property="Foreground"
                                    Value="#777777"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="Calculate" TargetType="Button">

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="#191919"/>

        <Setter Property="Foreground">

            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#7E20C1" Offset="0"/>
                    <GradientStop Color="#FD2357" Offset="0.5"/>
                    <GradientStop Color="#F08C33" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>

        </Setter>

        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3E403F"/>
        <Setter Property="FontFamily" Value="/Assets/Fonts/#Exo 2"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Grid>

                        <Border x:Name="mainBorder"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>

                        </Border>

                        <VisualStateManager.VisualStateGroups>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="mainBorder"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#252525"
                                            Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>

                                        <ColorAnimation
                                            Storyboard.TargetName="mainBorder"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1B1B1B"
                                            Duration="0:0:0.08"/>

                                        <DoubleAnimation
                                            Storyboard.TargetName="mainBorder"
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                            To="0.96"
                                            Duration="0:0:0.08"/>

                                        <DoubleAnimation
                                            Storyboard.TargetName="mainBorder"
                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                            To="0.96"
                                            Duration="0:0:0.08"/>

                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0"/>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                    </Grid>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="Outputs" TargetType="TextBox">

        <Setter Property="Background" Value="#191919"/>
        <Setter Property="Foreground" Value="#BDBDBD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3E403F"/>
        <Setter Property="FontFamily" Value="/Assets/Fonts/#Exo 2"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,5,5"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="SelectionBrush" Value="#555555"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border
                        CornerRadius="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="5,2,5,2"/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="WindowControl" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Grid x:Name="grid"
                          Background="#01000000">

                        <Image Source="/Assets/Images/Buttons/min.png"
                               Width="12"
                               Height="12"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="grid"
                                    Property="Background"
                                    Value="#202020"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="grid"
                                    Property="Background"
                                    Value="#1B1B1B"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="WindowClose" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Grid x:Name="grid"
                          Background="#01000000">

                        <Image Source="/Assets/Images/Buttons/close.png"
                               Width="12"
                               Height="12"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="grid"
                                    Property="Background"
                                    Value="#202020"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="grid"
                                    Property="Background"
                                    Value="#1B1B1B"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="HeaderStyle" TargetType="Button">

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#656565"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                
                <Setter Property="Foreground"
                        Value="#919191"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                
                <Setter Property="Foreground"
                        Value="#C2C2C2"/>
            </Trigger>
        </Style.Triggers>

    </Style>

</ResourceDictionary>