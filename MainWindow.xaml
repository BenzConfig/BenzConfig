<Window x:Class="benzconfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BenzConfig"
        Background="#0A0A0A"
        Height="600"
        Width="700"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        FocusManager.FocusedElement="{Binding ElementName=InputSummer}"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#000000">

            <Grid>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0">

                    <TextBlock Text="BenzConfig"
                               Foreground="#BABABA"
                               FontFamily="/Assets/Fonts/#Bai Jamjuree"
                               FontWeight="SemiBold"
                               FontSize="16"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="2.5"
                               Margin="5,0,0,0"
                               FontFamily="Bluelands"
                               FontSize="16"
                               VerticalAlignment="Center">

                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#7E20C1" Offset="0"/>
                                <GradientStop Color="#FD2357" Offset="0.5"/>
                                <GradientStop Color="#F08C33" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>

                    </TextBlock>

                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <Button Click="BtnMinimize_Click"
                            Style="{StaticResource WindowControl}"/>

                    <Button Click="BtnClose_Click"
                            Style="{StaticResource WindowClose}"/>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="1"
                Background="#101010">

            <DockPanel Margin="15,0,0,0"
                       LastChildFill="False">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left">

                    <Button Content="Настройки"
                        x:Name="SettingsWindow"
                        Style="{StaticResource HeaderStyle}"
                        FontFamily="Manrope"
                        FontWeight="Medium"
                        FontSize="13"
                        Click="SettingButton_Click"/>

                    <Button Content="Справка"
                        Style="{StaticResource HeaderStyle}"                     
                        FontFamily="Manrope"
                        FontWeight="Medium"
                        FontSize="13"
                        Click="AboutButton_Click"
                        Margin="10,0,0,0"/>

                </StackPanel>

            </DockPanel>
            
        </Border>

        <Grid Grid.Row="2"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid 
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Летний пробег"
                    Foreground="#979797"
                    FontFamily="Manrope"
                    FontWeight="Regular"
                    FontSize="14"
                    Margin="0,0,0,10"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="InputSummer"
                    Style="{StaticResource Inputs}"
                    Foreground="#BDBDBD"
                    FontFamily="Manrope"
                    FontWeight="Regular"
                    MaxLength="10"
                    Margin="0,0,1,1"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    PreviewTextInput="NumberOnly"
                    GotFocus="Summer_GotFocus"/>

                <Button
                    Grid.Row="2"
                    x:Name="BtnSummer"
                    Style="{StaticResource Calculate}"
                    Content="Рассчитать"
                    Margin="0,6,1,1"
                    Click="BtnSummer_Click"/>

            </Grid>

            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Margin="5,0,0,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Зимний пробег"
                    Foreground="#979797"
                    FontFamily="Manrope"
                    FontWeight="Regular"
                    FontSize="14"
                    Margin="1,0,0,10"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="InputWinter"
                    Style="{StaticResource Inputs}"
                    Foreground="#BDBDBD"
                    FontFamily="Manrope"
                    FontWeight="Regular"
                    MaxLength="10"
                    Margin="1,0,0,1"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    PreviewTextInput="NumberOnly"
                    GotFocus="Winter_GotFocus"/>

                <Button
                    Grid.Row="2"
                    x:Name="BtnWinter"
                    Style="{StaticResource Calculate}"
                    Content="Рассчитать"
                    Margin="1,6,0,1"
                    Click="BtnWinter_Click"/>

            </Grid>

            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                x:Name="OutSummer"
                Style="{StaticResource Outputs}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="0,0,6,0"/>

            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                x:Name="OutWinter"
                Style="{StaticResource Outputs}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="6,0,0,0"/>

        </Grid>

    </Grid>

</Window>