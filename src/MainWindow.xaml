<Window
    x:Class="benzconfig.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BenzConfig" Background="#0A0A0A" Height="600" Width="700"
    WindowStyle="None" ResizeMode="CanMinimize"
    FocusManager.FocusedElement="{Binding ElementName=InputSummer}" KeyDown="Window_KeyDown"
    WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Background="Black">

            <Grid>
                <!-- Название и версия -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0">

                    <TextBlock
                        Opacity="0.9"
                        Text="BenzConfig"
                        Foreground="White"
                        FontFamily="/res/font/Baijamjuree/#Bai jamjuree"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="2.5"
                        Margin="5,0,0,0"
                        FontFamily="/res/font/Bluelands/#Bluelands"
                        FontSize="20"
                        FontWeight="Regular"
                        VerticalAlignment="Center">

                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#7E20C1" Offset="0"/>
                                <GradientStop Color="#FD2357" Offset="0.5"/>
                                <GradientStop Color="#F08C33" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>

                    </TextBlock>

                </StackPanel>

                <!-- Кнопки окна -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <Button
                        Style="{StaticResource WindowControl}"
                        Tag="/res/img/min.png"
                        Click="BtnMinimize_Click"/>

                    <Button
                        Style="{StaticResource WindowControl}"
                        Tag="/res/img/close.png"
                        Click="BtnClose_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Menubar-->
        <Border
            Grid.Row="1"
            Background="#111111">

            <DockPanel
                Margin="10,0,0,0"
                LastChildFill="False">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left">

                    <Button
                        Content="Справка"
                        Style="{StaticResource HeaderStyle}"                     
                        FontFamily="/res/font/Inter/#Inter"
                        FontWeight="Regular"
                        FontSize="12"
                        Click="AboutButton_Click"/>

                    <Button 
                        x:Name="SettingsWindow"
                        Content="Настройки"
                        Style="{StaticResource HeaderStyle}"
                        FontFamily="/res/font/Inter/#Inter"
                        FontWeight="Regular"
                        FontSize="12"
                        Click="SettingButton_Click"
                        Margin="15,0,0,0"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid 
            Grid.Row="2"
            Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА -->
            <Grid 
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Летний пробег"
                    Style="{StaticResource Labels}"
                    FontFamily="/res/font/Inter/#Inter"
                    FontWeight="Regular"
                    FontSize="14"
                    Margin="0,0,0,10"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="InputSummer"
                    Style="{StaticResource Inputs}"
                    Foreground="#BDBDBD"
                    FontFamily="/res/font/Inter/#Inter"
                    FontWeight="Regular"
                    MaxLength="10"
                    Margin="0,0,0,1"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    PreviewTextInput="NumberOnly"
                    GotFocus="Summer_GotFocus"/>

                <Button
                    Grid.Row="2"
                    x:Name="BtnSummer"
                    Style="{StaticResource Calculate}"
                    Content="Рассчитать"
                    Margin="0,6,0,1"
                    Click="BtnSummer_Click">

                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#7E20C1" Offset="0"/>
                            <GradientStop Color="#FD2357" Offset="0.5"/>
                            <GradientStop Color="#F08C33" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>

                </Button>

            </Grid>


            <!-- ПРАВАЯ КОЛОНКА -->
            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Margin="5,0,0,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Зимний пробег"
                    Style="{StaticResource Labels}"
                    FontFamily="/res/font/Inter/#Inter"
                    FontWeight="Regular"
                    FontSize="14"
                    Margin="0,0,0,10"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="InputWinter"
                    Style="{StaticResource Inputs}"
                    Foreground="#BDBDBD"
                    FontFamily="/res/font/Inter/#Inter"
                    FontWeight="Regular"
                    MaxLength="10"
                    Margin="0,0,0,1"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    PreviewTextInput="NumberOnly"
                    GotFocus="Winter_GotFocus"/>

                <Button
                    Grid.Row="2"
                    x:Name="BtnWinter"
                    Style="{StaticResource Calculate}"
                    Content="Рассчитать"
                    Margin="0,6,0,1"
                    Click="BtnWinter_Click"/>

            </Grid>


            <!-- ВЫВОД СЛЕВА -->
            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                x:Name="OutSummer"
                Style="{StaticResource Outputs}"
                FontFamily="/res/font/Exo2/#Exo 2"
                FontWeight="Regular"
                FontSize="14"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="0,0,5,0"/>


            <!-- ВЫВОД СПРАВА -->
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                x:Name="OutWinter"
                Style="{StaticResource Outputs}"
                FontFamily="/res/font/Exo2/#Exo 2"
                FontWeight="Regular"
                FontSize="14"
                IsReadOnly="True"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Margin="5,0,0,0"/>

        </Grid>

    </Grid>

</Window>